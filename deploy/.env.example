# Copier en deploy/.env (jamais commité) et remplir. Générer chaque secret avec : openssl rand -hex 32 (sans espace)
# Après le déploiement : deploy/verify.sh https://<domaine>
GAMEBATTLE_DOMAIN=jeu.exemple.fr
GAMEBATTLE_PLAYER_ORIGINS=https://jeu.exemple.fr
GAMEBATTLE_DB_PASSWORD=
GAMEBATTLE_CONTROLLER_TOKEN=
GAMEBATTLE_DISPLAY_TOKEN=
GAMEBATTLE_HARDWARE_TOKEN=
# Clé HMAC des compteurs d'essais : un secret à part, jamais un des jetons ci-dessus. La changer remet les compteurs à zéro.
GAMEBATTLE_RATE_LIMIT_SECRET=
GAMEBATTLE_BLINDTEST_PLAYLIST_URL=
# Ports publiés sur la machine (80 et 443 en production)
GAMEBATTLE_HTTP_PORT=80
GAMEBATTLE_HTTPS_PORT=443
